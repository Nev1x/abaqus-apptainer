# Конфигурация инфраструктуры запуска Abaqus.
# Скопируйте в config.env и поправьте под свой сервер:  cp config.env.example config.env
# Все скрипты из scripts/ читают этот файл (или файл, указанный в переменной ABQ_CONFIG).
# Любую переменную можно переопределить из окружения: CPUS=8 scripts/run_job.sh ...

# --- Среда выполнения -------------------------------------------------------
# apptainer — образ .sif (рекомендуется для серверов/кластеров, не требует root)
# docker    — образ Docker (если Apptainer недоступен)
# native    — Abaqus установлен прямо на хосте, контейнер не используется
#             (единственный вариант для scripts\windows\*.ps1 на Windows)
RUNTIME=apptainer

# Путь к образу Apptainer (для RUNTIME=apptainer)
SIF=/opt/containers/abaqus-2022.sif
# Дополнительные флаги "apptainer exec". Если на сервере нет FUSE и запуск падает с
# "FATAL: exec ... failed: invalid argument", укажите --unsquash (см. README, раздел 9).
APPTAINER_FLAGS=

# Имя образа Docker (для RUNTIME=docker)
DOCKER_IMAGE=abaqus:2022

# Команда запуска Abaqus внутри контейнера (или на хосте при RUNTIME=native).
# Windows: abaqus (C:\SIMULIA\Commands\abaqus.bat в PATH) или полный путь к abaqus.bat
ABAQUS_CMD=abaqus

# Сервер лицензий FlexNet (порт@хост). Пусто — используется то, что записано
# в образ при установке (EstablishedProductsConfig.ini).
ABAQUSLM_LICENSE_FILE=

# --- Каталоги -----------------------------------------------------------
# Каталог с входными файлами *.inp
INPUT_DIR=./inputs
# Каталог результатов: для каждой задачи создаётся подкаталог <JOB>/
RESULTS_DIR=./results
# Быстрый локальный диск для временных файлов решателя (лучше NVMe, не NFS).
# Windows: например D:\scratch
SCRATCH_DIR=/tmp/abaqus-scratch

# --- Параметры расчёта --------------------------------------------------
# Ядер на одну задачу. Исходные задачи готовились на 20 ядер / 20 доменов.
CPUS=20
# Число одновременно выполняемых задач (scripts/run_queue.sh).
# Пусто — вычисляется как floor(число ядер сервера / CPUS).
PARALLEL=
# Память на одну задачу (формат Abaqus: "90%", "64gb", "16000mb").
# Пусто — 90% делится поровну между PARALLEL задачами.
MEMORY=
# threads — потоки в одном процессе (надёжно в контейнере на одном узле)
# mpi     — как в исходных задачах из CAE (mp_mode=MPI)
MP_MODE=threads
# Точность Abaqus/Explicit: single (как в исходных задачах) или double
PRECISION=single

# --- После расчёта ------------------------------------------------------
# 1 — извлечь кривую RF3(U3) и модули волокон в CSV (postprocess/)
POSTPROCESS=1
# 0 — удалить файлы перезапуска (.abq .pac .res .sel .stt .mdl .prt), ~0,7 ГБ на задачу;
# 1 — оставить (нужны только для *RESTART)
KEEP_RESTART=0
