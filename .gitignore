# Локальная конфигурация (пути и сервер лицензий конкретной машины)
config.env

# Дистрибутив Abaqus и собранные образы — лицензионные, в репозиторий не кладутся
media/
*.sif
*.tar

# Данные и результаты расчётов (гигабайты; хранятся на диске/сервере, не в git)
inputs/
results/
dataset/
dataset-*/
logs/
jobs.list
queue.log
archive/*.cae

# Служебные файлы
.DS_Store
__pycache__/
*.pyc
abaqus.rpy*
*.lck
